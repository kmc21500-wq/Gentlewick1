# Public environment variables for local development and Vercel.
# Never commit secrets. Cloud memorial creation is intentionally disabled unless
# VITE_CLOUD_MEMORIAL_CREATE_ENABLED=true is explicitly set.
VITE_PUBLIC_HOSTNAME=gentlewick.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_CLOUD_MEMORIAL_CREATE_ENABLED=false

# Server-only, required before enabling cloud memorial creation or owner actions.
# Do NOT prefix this with VITE_ and do not expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
